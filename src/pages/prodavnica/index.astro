---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { SITE } from "../../data/site";
import { PRODUCTS, CATEGORIES, CATEGORY_META } from "../../data/products";
import { priceRange } from "../../data/products";
import { money } from "../../lib/format";
import { withBase } from "../../lib/url";

const cats = CATEGORIES;
const [minP] = priceRange();

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Svi proizvodi — ${SITE.name}`,
  numberOfItems: PRODUCTS.length,
  itemListElement: PRODUCTS.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/proizvod/${p.slug}`, SITE.url).href,
    name: p.name,
  })),
};
---

<Base
  title="Svi proizvodi od jute — kanap, penjanje, nameštaj, rasveta"
  description={`Kompletna ponuda Juta Svet — ${PRODUCTS.length} proizvoda: jutani kanap na metar, kanapi za penjanje, nameštaj, rasveta i dekoracija od jute. Cene od ${money(minP)}. Dostava po Srbiji.`}
  jsonLd={[itemListLd]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Prodavnica" }]} />
    <header class="listing-head">
      <h1>Svi proizvodi</h1>
      <p>
        {PRODUCTS.length} proizvoda od jute, na metar i po meri. Cene od {money(minP)}.
        Besplatna dostava preko {money(SITE.freeShippingThreshold)}.
      </p>
      <nav class="chips" aria-label="Kategorije">
        <a href={withBase("/prodavnica")} aria-current="page">Sve</a>
        {cats.map((c) => <a href={withBase(`/kategorija/${c}`)}>{CATEGORY_META[c].title}</a>)}
      </nav>
    </header>

    <div class="section">
      <div class="product-grid">
        {PRODUCTS.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
      </div>
    </div>
  </div>
</Base>

<style>
  .listing-head {
    padding-block: 0.5rem 1.5rem;
  }
  .listing-head h1 {
    font-size: var(--step-3);
  }
  .listing-head p {
    color: var(--ink-soft);
    margin-top: 0.5rem;
    max-width: 60ch;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .chips a {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chips a[aria-current="page"] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
</style>

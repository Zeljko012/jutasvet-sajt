---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import { SITE } from "../../data/site";
import {
  CATEGORIES,
  CATEGORY_META,
  productsByCategory,
  type Category,
} from "../../data/products";
import { CATEGORY_SEO, fill } from "../../data/seo";
import { money } from "../../lib/format";
import { withBase } from "../../lib/url";

export function getStaticPaths() {
  return CATEGORIES.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params as { slug: Category };
const meta = CATEGORY_META[slug];
const seo = CATEGORY_SEO[slug];
const items = productsByCategory(slug);

const prices = items.filter((p) => !p.onRequest).map((p) => p.price);
if (prices.length === 0) prices.push(0);
const groupSlug = (g: string) =>
  g.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const groups = meta.groups
  .map((g) => ({ name: g, id: groupSlug(g), items: items.filter((p) => p.group === g) }))
  .filter((g) => g.items.length > 0);
const vars = {
  count: items.length,
  from: money(Math.min(...prices)),
  to: money(Math.max(...prices)),
};

const otherCats = CATEGORIES.filter(
  (c) => c !== slug,
);

const ld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seo.h1,
  url: new URL(`/kategorija/${slug}`, SITE.url).href,
  inLanguage: "sr-RS",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: items.length,
    itemListElement: items.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/proizvod/${p.slug}`, SITE.url).href,
      name: p.name,
    })),
  },
};
---

<Base title={seo.title} description={fill(seo.description, vars)} jsonLd={[ld]}>
  <div class="container">
    <Breadcrumbs items={[{ label: "Prodavnica", href: "/prodavnica" }, { label: meta.title }]} />
    <header class="listing-head">
      <h1>{seo.h1}</h1>
      <p>{meta.intro}</p>
      <nav class="chips" aria-label="Kategorije">
        <a href={withBase("/prodavnica")}>Sve</a>
        <a href={withBase(`/kategorija/${slug}`)} aria-current="page">{meta.title}</a>
        {otherCats.map((c) => <a href={withBase(`/kategorija/${c}`)}>{CATEGORY_META[c].title}</a>)}
      </nav>
    </header>

    {
      groups.length > 1 && (
        <nav class="jump" aria-label="Grupe u kategoriji">
          {groups.map((g) => (
            <a href={`#${g.id}`}>
              {g.name} <span>{g.items.length}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      groups.map((g, gi) => (
        <section class="group" id={g.id} aria-labelledby={`${g.id}-h`}>
          {groups.length > 1 && (
            <div class="group__head">
              <h2 id={`${g.id}-h`}>{g.name}</h2>
              <span class="eyebrow">
                {g.items.length} {g.items.length === 1 ? "proizvod" : "proizvoda"}
              </span>
            </div>
          )}
          <div class="product-grid">
            {g.items.map((p, i) => <ProductCard product={p} eager={gi === 0 && i < 4} />)}
          </div>
        </section>
      ))
    }

    <section class="seo-copy">
      {
        seo.sections.map((s) => (
          <div class="seo-copy__block">
            <h2>{s.h2}</h2>
            {s.p.map((t) => <p>{t}</p>)}
          </div>
        ))
      }
    </section>

    <div class="faq-wrap">
      <FaqBlock faqs={seo.faqs.map((f) => ({ q: fill(f.q, vars), a: fill(f.a, vars) }))} />
    </div>

    <nav class="also" aria-label="Pogledaj i">
      <h2>Pogledaj i</h2>
      <ul>
        {seo.related.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
        {otherCats.map((c) => <li><a href={withBase(`/kategorija/${c}`)}>{CATEGORY_META[c].heading}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .listing-head {
    padding-block: 0.5rem 1.5rem;
  }
  .listing-head h1 {
    font-size: var(--step-3);
  }
  .listing-head p {
    color: var(--ink-soft);
    margin-top: 0.5rem;
    max-width: 62ch;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .chips a {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chips a[aria-current="page"] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .jump {
    position: sticky;
    top: 64px;
    z-index: 5;
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding: 0.6rem 0;
    margin-bottom: 0.5rem;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .jump a {
    flex: 0 0 auto;
    text-decoration: none;
    font: 500 0.74rem/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    color: var(--ink-soft);
  }
  .jump a:hover {
    color: var(--accent);
    background: var(--surface);
  }
  .jump span {
    color: var(--clay);
    margin-left: 0.2rem;
  }
  .group {
    padding-block: 1.5rem 2rem;
    scroll-margin-top: 130px;
  }
  .group__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    margin-bottom: 1.4rem;
  }
  .group__head h2 {
    font-size: var(--step-2);
  }
  .seo-copy {
    display: grid;
    gap: 2rem;
    max-width: 760px;
    padding-block: 1rem 2.5rem;
    border-top: 1px solid var(--line);
    margin-top: 1rem;
    padding-top: 2.5rem;
  }
  .seo-copy h2 {
    font-size: var(--step-2);
    margin-bottom: 0.6rem;
  }
  .seo-copy p {
    color: var(--ink-soft);
  }
  .seo-copy p + p {
    margin-top: 0.8rem;
  }
  .faq-wrap {
    padding-bottom: 2.5rem;
  }
  .also {
    padding-block: 0 2rem;
  }
  .also h2 {
    font-size: var(--step-1);
    margin-bottom: 0.8rem;
  }
  .also ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .also a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .also a:hover {
    text-decoration: underline;
  }
</style>

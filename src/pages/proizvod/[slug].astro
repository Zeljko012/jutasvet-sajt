---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import { SITE } from "../../data/site";
import {
  PRODUCTS,
  getProduct,
  relatedProducts,
  priceFromLabel,
  CATEGORY_META,
} from "../../data/products";
import { money, discountPct } from "../../lib/format";
import { withBase } from "../../lib/url";

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params as { slug: string };
const p = getProduct(slug);
if (!p) return Astro.redirect(withBase("/404"));

const cat = CATEGORY_META[p.category];
const off = discountPct(p.price, p.compareAt);
const related = relatedProducts(p, 4);
const url = new URL(`/proizvod/${p.slug}`, SITE.url).href;
const hasChoice = p.options.length > 0;
const single = p.variants.length === 1 ? p.variants[0] : null;
const inquiryHref = withBase(`/kontakt?proizvod=${encodeURIComponent(p.name)}`);

const gallery = p.images.map((im) => ({
  src: withBase(im.src),
  zoom: withBase(im.src.replace(".webp", "-lg.webp")),
  alt: im.alt,
}));

const variantsJson = JSON.stringify(
  p.variants.map((v) => ({
    k: v.key,
    l: v.label,
    o: v.options,
    p: v.price,
    i: v.image ? withBase(v.image) : null,
  })),
);

const multiPrice = p.maxPrice > p.price;
const productLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  description: p.seoDescription,
  image: p.images.map((im) => new URL(im.src, SITE.url).href),
  sku: p.slug,
  brand: { "@type": "Brand", name: SITE.name },
  category: cat.title,
  material: "Juta",
};
if (!p.onRequest) {
  productLd.offers = {
    "@type": multiPrice ? "AggregateOffer" : "Offer",
    url,
    priceCurrency: SITE.currency,
    ...(multiPrice
      ? { lowPrice: p.price, highPrice: p.maxPrice, offerCount: p.variants.filter((v) => v.price > 0).length }
      : { price: p.price }),
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    seller: { "@type": "Organization", name: SITE.name },
  };
}

const specs = p.specs;
const startPrice = single ? (p.onRequest ? "Cena na upit" : money(single.price)) : priceFromLabel(p, money);
---

<Base
  title={p.seoTitle}
  description={p.seoDescription}
  image={p.images[0]?.src}
  type="product"
  jsonLd={[productLd]}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Prodavnica", href: "/prodavnica" },
        { label: cat.title, href: `/kategorija/${p.category}` },
        { label: p.name },
      ]}
    />

    <div class="pdp">
      <!-- GALERIJA -->
      <div class="gallery" data-gallery>
        <div class="gallery__main">
          {off && <span class="pill pill--sale gallery__badge">−{off}%</span>}
          <img
            data-main
            src={gallery[0]?.src}
            data-zoom={gallery[0]?.zoom}
            alt={gallery[0]?.alt}
            width="1000"
            height="1250"
            fetchpriority="high"
          />
        </div>
        {
          gallery.length > 1 && (
            <div class="gallery__thumbs" role="tablist" aria-label="Slike proizvoda">
              {gallery.map((im, i) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-thumb
                  data-src={im.src}
                  data-zoom={im.zoom}
                  data-alt={im.alt}
                >
                  <img src={im.src} alt="" width="120" height="150" loading="lazy" />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- INFO -->
      <div class="info">
        <p class="info__cat eyebrow">{cat.title} · {p.group}</p>
        <h1>{p.name}</h1>

        <p class="info__price">
          {p.compareAt && !p.onRequest && <span class="price__old">{money(p.compareAt)}</span>}
          <span class:list={["price", "info__now", { "price__now--sale": !!p.compareAt }]} data-now>
            {startPrice}
          </span>
        </p>

        <p class="info__lead">{p.lead}</p>

        {
          p.onRequest ? (
            <div class="buy">
              {p.options.map((o) => (
                <div class="opt">
                  <p class="opt__legend">{o.name}</p>
                  <div class="opt__grid">
                    {o.values.map((v) => (
                      <span class="opt__chip--static">{v}</span>
                    ))}
                  </div>
                </div>
              ))}
              <p class="ask-note">
                Cena zavisi od dimenzija i izrade. Pošaljite upit — javljamo se sa ponudom, najčešće istog dana.
              </p>
              <div class="buy__row">
                <a class="btn btn--lg buy__add" href={inquiryHref}>
                  Pošalji upit
                </a>
                <a class="btn btn--ghost btn--lg" href={SITE.phoneHref}>
                  Pozovi
                </a>
              </div>
            </div>
          ) : (
            <form
              class="buy"
              data-buy
              data-slug={p.slug}
              data-name={p.name}
              data-image={gallery[0]?.src}
              data-inquiry={inquiryHref}
            >
              <script type="application/json" data-variants set:html={variantsJson} />
              {p.options.map((o, oi) => (
                <fieldset class="opt" data-opt={oi} data-opt-label={o.name}>
                  <legend class="opt__legend">
                    {o.name}: <b data-opt-name>{o.values.length === 1 ? o.values[0] : "izaberite"}</b>
                  </legend>
                  <div class="opt__grid">
                    {o.values.map((v) => (
                      <label class="opt__chip">
                        <input type="radio" name={`opt${oi}`} value={v} checked={o.values.length === 1} />
                        <span>{v}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))}

              <div class="buy__row">
                <div class="qty" role="group" aria-label="Količina">
                  <button type="button" data-dec aria-label="Smanji količinu">
                    −
                  </button>
                  <input type="number" data-qty value="1" min="1" max="20" inputmode="numeric" aria-label="Količina" />
                  <button type="button" data-inc aria-label="Povećaj količinu">
                    +
                  </button>
                </div>
                <button type="submit" class="btn btn--lg buy__add" data-add>
                  {hasChoice && !single ? "Izaberite opcije" : "Dodaj u korpu"}
                </button>
              </div>
              <p class="buy__hint" data-hint hidden />
            </form>
          )
        }

        <ul class="usp">
          <li>Besplatna dostava preko {money(SITE.freeShippingThreshold)}</li>
          <li>Slanje za {SITE.deliveryTime}, po celoj Srbiji</li>
          <li>{SITE.paymentNote}</li>
          <li>Sečenje i izrada po meri — pitajte nas</li>
        </ul>

        <div class="acc">
          <details open>
            <summary>Detalji</summary>
            <ul class="specs">
              {specs.map((s) => <li>{s}</li>)}
              {p.options.map((o) => <li>{o.name}: {o.values.join(", ")}</li>)}
              {!specs.some((s) => /^Materijal/i.test(s)) && <li>Materijal: juta</li>}
              <li>Kategorija: {cat.title} — {p.group}</li>
            </ul>
          </details>
          <details>
            <summary>Za koga je</summary>
            <p>{p.forWhom}</p>
          </details>
          <details>
            <summary>Dostava i povraćaj</summary>
            <p>
              Dostava kurirskom službom po celoj Srbiji, {SITE.deliveryTime} od potvrde
              porudžbine. Plaćanje pouzećem. Zamena ili povraćaj u roku od 14 dana
              (osim robe sečene ili rađene po meri) — detalji na strani{" "}
              <a href={withBase("/dostava-i-povracaj")}>Dostava i povraćaj</a>.
            </p>
          </details>
        </div>
      </div>
    </div>

    <!-- OPIS -->
    <section class="desc section">
      <div class="desc__col">
        <h2>O proizvodu</h2>
        <p>{p.lead}</p>
        {p.description.map((t) => <p>{t}</p>)}
        <p>
          Treba vam drugačija dužina, debljina ili izrada po meri? Javite nam se na{" "}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> ili <a href={SITE.phoneHref}>{SITE.phone}</a>.
        </p>
      </div>
      <div class="desc__col">
        <h2>Zašto Juta Svet</h2>
        <ul class="why">
          <li>Porodična proizvodnja — višegodišnje iskustvo sa kanapom od jute</li>
          <li>Prirodna juta — biorazgradiva, bez hemikalija i veštačkih vlakana</li>
          <li>Tačna dužina i debljina — sečemo i pakujemo prema vašem projektu</li>
          <li>Ručna izrada i kontrola kvaliteta svakog komada</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Moglo bi da vam zatreba</h2>
        <a href={withBase(`/kategorija/${p.category}`)}>Sve iz kategorije {cat.title} →</a>
      </div>
      <div class="product-grid">
        {related.map((r) => <ProductCard product={r} />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .pdp {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: 1rem 1.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .pdp {
      grid-template-columns: 1fr;
    }
  }

  .gallery,
  .info {
    min-width: 0;
  }
  .gallery__main {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-tint);
    aspect-ratio: 4 / 5;
  }
  .gallery__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }
  .gallery__badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    z-index: 2;
  }
  .gallery__thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
  }
  .gallery__thumbs button {
    flex: 0 0 auto;
    width: 72px;
    height: 90px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-tint);
    cursor: pointer;
  }
  .gallery__thumbs button[aria-selected="true"] {
    border-color: var(--accent);
    outline: 1px solid var(--accent);
  }
  .gallery__thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info__cat {
    margin-bottom: 0.4rem;
  }
  .info h1 {
    font-size: var(--step-3);
  }
  .info__price {
    margin-top: 0.6rem;
    font-size: 1.35rem;
  }
  .info__lead {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .buy {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .opt {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .opt__legend {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
    padding: 0;
  }
  .opt__legend b {
    color: var(--ink);
    font-weight: 600;
  }
  .opt__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .opt__chip {
    position: relative;
    cursor: pointer;
  }
  .opt__chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opt__chip span,
  .opt__chip--static {
    display: inline-block;
    min-width: 3rem;
    text-align: center;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font: 500 0.85rem/1.1 var(--font-body);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    background: var(--surface);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .opt__chip:hover span {
    border-color: var(--accent);
  }
  .opt__chip input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .opt__chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .opt__chip.is-off span {
    opacity: 0.4;
    text-decoration: line-through;
  }
  .ask-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .buy__hint {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-top: -0.4rem;
  }
  .buy__hint :global(a) {
    color: var(--accent);
  }

  .buy__row {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
  }
  .qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0 0.25rem;
  }
  .qty button {
    width: 34px;
    height: 44px;
    border: none;
    background: none;
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .qty input {
    width: 2.5rem;
    text-align: center;
    border: none;
    background: none;
    color: var(--ink);
    font: inherit;
    font-variant-numeric: tabular-nums;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .qty input::-webkit-outer-spin-button,
  .qty input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .buy__add {
    flex: 1;
  }

  .usp {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .usp li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--ink-soft);
  }
  .usp li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .acc {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .acc details {
    border-bottom: 1px solid var(--line);
  }
  .acc summary {
    padding: 0.9rem 0;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc summary::after {
    content: "+";
    color: var(--ink-soft);
  }
  .acc details[open] summary::after {
    content: "–";
  }
  .acc details > :not(summary) {
    padding-bottom: 1rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .specs {
    margin: 0;
    padding-left: 1.1rem;
  }
  .specs li + li {
    margin-top: 0.3rem;
  }
  .acc a {
    color: var(--accent);
  }

  .desc {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .desc h2 {
    font-size: var(--step-2);
    margin-bottom: 0.7rem;
  }
  .desc__col > p + p {
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }
  .desc__col > p:first-of-type {
    color: var(--ink);
  }
  .desc__col a {
    color: var(--accent);
  }
  .why {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .why li + li {
    margin-top: 0.5rem;
  }
  @media (max-width: 760px) {
    .desc {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { addItem } from "../../lib/cart";
  import { money } from "../../lib/format";

  // ── Galerija ────────────────────────────────────────────────────────
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const main = gallery?.querySelector<HTMLImageElement>("[data-main]") ?? null;
  function showImage(src: string, zoom?: string, alt?: string) {
    if (!main || !gallery) return;
    main.src = src;
    main.dataset.zoom = zoom || src.replace(".webp", "-lg.webp");
    if (alt !== undefined) main.alt = alt;
    gallery
      .querySelectorAll<HTMLButtonElement>("[data-thumb]")
      .forEach((b) => b.setAttribute("aria-selected", String(b.dataset.src === src)));
  }
  if (gallery && main) {
    gallery.querySelectorAll<HTMLButtonElement>("[data-thumb]").forEach((btn) => {
      btn.addEventListener("click", () => showImage(btn.dataset.src!, btn.dataset.zoom, btn.dataset.alt || ""));
    });
    main.addEventListener("click", () => {
      const z = main.dataset.zoom;
      if (z) window.open(z, "_blank", "noopener");
    });
  }

  // ── Kupovina (izbor varijante) ─────────────────────────────────────
  type V = { k: string; l: string; o: string[]; p: number; i: string | null };
  const form = document.querySelector<HTMLFormElement>("[data-buy]");
  if (form) {
    const variants: V[] = JSON.parse(form.querySelector("[data-variants]")?.textContent || "[]");
    const groups = [...form.querySelectorAll<HTMLFieldSetElement>("[data-opt]")];
    const qty = form.querySelector<HTMLInputElement>("[data-qty]")!;
    const addBtn = form.querySelector<HTMLButtonElement>("[data-add]")!;
    const hint = form.querySelector<HTMLElement>("[data-hint]")!;
    const nowEl = document.querySelector<HTMLElement>("[data-now]");
    const fromLabel = nowEl?.textContent?.trim() || "";

    const selected = () =>
      groups.map((g) => g.querySelector<HTMLInputElement>("input:checked")?.value ?? null);
    const current = (): V | null => {
      if (groups.length === 0) return variants[0] ?? null;
      const sel = selected();
      if (sel.some((x) => x === null)) return null;
      return variants.find((v) => v.o.every((x, i) => x === sel[i])) ?? null;
    };
    const clamp = () => {
      let n = parseInt(qty.value || "1", 10);
      if (isNaN(n) || n < 1) n = 1;
      if (n > 20) n = 20;
      qty.value = String(n);
      return n;
    };

    function refresh() {
      const sel = selected();
      // precrtaj vrednosti za koje ne postoji varijanta uz ostale izabrane opcije
      groups.forEach((g, gi) => {
        g.querySelectorAll<HTMLInputElement>("input").forEach((inp) => {
          const ok = variants.some((v) =>
            v.o.every((x, i) => (i === gi ? x === inp.value : sel[i] === null || x === sel[i])),
          );
          inp.closest(".opt__chip")?.classList.toggle("is-off", !ok);
        });
        const nm = g.querySelector<HTMLElement>("[data-opt-name]");
        if (nm) nm.textContent = sel[gi] ?? "izaberite";
      });

      const v = current();
      hint.hidden = true;
      hint.innerHTML = "";
      if (v) {
        if (nowEl) nowEl.textContent = v.p > 0 ? money(v.p) : "Cena na upit";
        if (v.i && main && !main.src.endsWith(v.i)) showImage(v.i);
        addBtn.textContent =
          v.p > 0 ? `Dodaj u korpu · ${money(v.p * clamp())}` : "Pošalji upit";
        return;
      }
      if (nowEl) nowEl.textContent = fromLabel;
      if (sel.every((x) => x !== null)) {
        addBtn.textContent = "Kombinacija nije dostupna";
        hint.innerHTML = `Ova kombinacija nije u ponudi — <a href="${form!.dataset.inquiry}">pošaljite upit</a>, sečemo i po meri.`;
        hint.hidden = false;
      } else {
        const missing = groups.find((_, i) => sel[i] === null)?.dataset.optLabel;
        addBtn.textContent = missing ? `Izaberite: ${missing.toLowerCase()}` : "Izaberite opcije";
      }
    }

    form.querySelector("[data-dec]")!.addEventListener("click", () => {
      qty.value = String(Math.max(1, clamp() - 1));
      refresh();
    });
    form.querySelector("[data-inc]")!.addEventListener("click", () => {
      qty.value = String(Math.min(20, clamp() + 1));
      refresh();
    });
    qty.addEventListener("change", refresh);
    form.addEventListener("change", (e) => {
      if ((e.target as HTMLElement).matches('input[type="radio"]')) refresh();
    });
    refresh();

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = current();
      if (!v) {
        window.dispatchEvent(
          new CustomEvent("juta:toast", { detail: "Izaberite sve opcije proizvoda." }),
        );
        return;
      }
      if (v.p <= 0) {
        window.location.href = form.dataset.inquiry!;
        return;
      }
      addItem(
        {
          slug: form.dataset.slug!,
          name: form.dataset.name!,
          price: v.p,
          color: v.k,
          colorLabel: v.l,
          image: v.i || form.dataset.image!,
        },
        clamp(),
      );
      window.dispatchEvent(new CustomEvent("juta:added"));
      window.dispatchEvent(
        new CustomEvent("juta:toast", { detail: `„${form.dataset.name}” dodato u korpu` }),
      );
    });
  }
</script>

---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../data/site";
import { REFERENCES } from "../data/references";
import { withBase } from "../lib/url";

const total = REFERENCES.reduce((n, r) => n + r.images.length, 0);
const ld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Reference — Juta Svet",
  url: new URL("/reference", SITE.url).href,
  inLanguage: "sr-RS",
  hasPart: REFERENCES.map((r) => ({
    "@type": "CreativeWork",
    name: r.title,
    image: new URL(`/images/reference/${r.id}-1-lg.webp`, SITE.url).href,
  })),
};
---

<Base
  title="Reference — naši radovi od jute"
  description="Reference Juta Svet: plafoni od kanapa za kafane i terase, bokobrani za plovila, ograde i gelenderi, rasveta i ljuljaške — izrada po meri, od ideje do realizacije."
  image="/images/reference/krovna-terasa-1-lg.webp"
  jsonLd={[ld]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Reference" }]} />
    <header class="ref-head">
      <span class="eyebrow">Od ideje do realizacije</span>
      <h1>Reference</h1>
      <p>
        Projekti koje smo radili po meri — za ugostitelje, plovila, terase i domove. Svaki
        počinje razgovorom i fotografijom prostora, a završava se montažom.
      </p>
      <nav class="jump" aria-label="Projekti">
        {REFERENCES.map((r) => <a href={`#${r.id}`}>{r.kicker.split(" · ")[0]}</a>)}
      </nav>
    </header>

    {
      REFERENCES.map((r, ri) => (
        <section class="ref" id={r.id} aria-labelledby={`${r.id}-h`}>
          <div class="ref__copy">
            <span class="ref__i">0{ri + 1}</span>
            <p class="eyebrow">{r.kicker}</p>
            <h2 id={`${r.id}-h`}>{r.title}</h2>
            <p>{r.text}</p>
            {r.link && (
              <a class="ref__link" href={withBase(r.link.href)}>
                {r.link.label} →
              </a>
            )}
          </div>
          <div class="ref__grid">
            {r.images.map(([w, h], i) => (
              <button
                type="button"
                class:list={["ref__tile", { "ref__tile--wide": i === 0 }]}
                data-lightbox
                data-src={withBase(`/images/reference/${r.id}-${i + 1}-lg.webp`)}
                data-alt={`${r.title} — slika ${i + 1}`}
                aria-label={`Uvećaj: ${r.title}, slika ${i + 1}`}
              >
                <img
                  src={withBase(`/images/reference/${r.id}-${i + 1}.webp`)}
                  alt={`${r.title} — slika ${i + 1}`}
                  width={w}
                  height={h}
                  loading={ri === 0 && i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </button>
            ))}
          </div>
        </section>
      ))
    }

    <section class="ref-cta">
      <div>
        <h2>Imate ideju za svoj prostor?</h2>
        <p>
          Pošaljite nam fotografije i okvirne dimenzije — predložićemo rešenje, materijal i cenu.
          Do sada {total}+ fotografija urađenih radova, a svaki naredni projekat je novi izazov.
        </p>
      </div>
      <div class="ref-cta__btns">
        <a class="btn btn--lg" href={withBase("/kontakt?proizvod=Izrada%20po%20meri")}>Pošalji upit</a>
        <a class="btn btn--ghost btn--lg" href={SITE.social.instagram} target="_blank" rel="noopener">
          Instagram
        </a>
      </div>
    </section>
  </div>

  <dialog class="lb" data-lb aria-label="Uvećana slika">
    <button type="button" class="lb__close" data-lb-close aria-label="Zatvori">×</button>
    <button type="button" class="lb__nav lb__prev" data-lb-prev aria-label="Prethodna slika">‹</button>
    <img data-lb-img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" />
    <button type="button" class="lb__nav lb__next" data-lb-next aria-label="Sledeća slika">›</button>
  </dialog>
</Base>

<style>
  .ref-head {
    padding-block: 0.5rem 1rem;
  }
  .ref-head h1 {
    font-size: var(--step-4);
    margin-top: 0.6rem;
  }
  .ref-head > p {
    color: var(--ink-soft);
    margin-top: 0.7rem;
    max-width: 62ch;
    font-size: var(--step-1);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .jump a {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ref {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  .ref:first-of-type {
    margin-top: 1.5rem;
  }
  .ref__copy {
    position: sticky;
    top: 96px;
    align-self: start;
  }
  .ref__i {
    display: block;
    font: 500 0.78rem/1 var(--font-mono);
    color: var(--clay);
    margin-bottom: 0.9rem;
  }
  .ref__copy h2 {
    font-size: var(--step-3);
    margin-top: 0.5rem;
  }
  .ref__copy > p:not(.eyebrow) {
    color: var(--ink-soft);
    margin-top: 0.8rem;
    max-width: 42ch;
  }
  .ref__link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .ref__link:hover {
    text-decoration: underline;
  }
  .ref__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .ref__tile {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-tint);
    cursor: zoom-in;
    aspect-ratio: 1 / 1;
  }
  .ref__tile--wide {
    grid-column: span 2;
    grid-row: span 2;
  }
  .ref__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .ref__tile:hover img {
    transform: scale(1.04);
  }
  @media (max-width: 860px) {
    .ref {
      grid-template-columns: 1fr;
    }
    .ref__copy {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .ref__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ref-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1rem;
  }
  .ref-cta h2 {
    font-size: var(--step-2);
  }
  .ref-cta p {
    color: var(--ink-soft);
    margin-top: 0.4rem;
    max-width: 56ch;
  }
  .ref-cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* lightbox */
  .lb {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(18, 13, 10, 0.92);
  }
  .lb[open] {
    display: grid;
    place-items: center;
  }
  .lb::backdrop {
    background: rgba(18, 13, 10, 0.6);
  }
  .lb img {
    max-width: min(92vw, 1600px);
    max-height: 86vh;
    object-fit: contain;
    border-radius: 10px;
  }
  .lb button {
    position: absolute;
    border: none;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb button:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .lb__close {
    top: 1rem;
    right: 1rem;
  }
  .lb__prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb__next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  const lb = document.querySelector<HTMLDialogElement>("[data-lb]");
  const img = lb?.querySelector<HTMLImageElement>("[data-lb-img]");
  const tiles = [...document.querySelectorAll<HTMLButtonElement>("[data-lightbox]")];
  let idx = 0;
  const show = (i: number) => {
    if (!img) return;
    idx = (i + tiles.length) % tiles.length;
    img.src = tiles[idx].dataset.src!;
    img.alt = tiles[idx].dataset.alt || "";
  };
  tiles.forEach((t, i) =>
    t.addEventListener("click", () => {
      show(i);
      lb?.showModal();
    }),
  );
  lb?.querySelector("[data-lb-close]")?.addEventListener("click", () => lb.close());
  lb?.querySelector("[data-lb-prev]")?.addEventListener("click", () => show(idx - 1));
  lb?.querySelector("[data-lb-next]")?.addEventListener("click", () => show(idx + 1));
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) lb.close();
  });
  document.addEventListener("keydown", (e) => {
    if (!lb?.open) return;
    if (e.key === "ArrowLeft") show(idx - 1);
    if (e.key === "ArrowRight") show(idx + 1);
  });
</script>

---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../data/site";

const localLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: SITE.name,
  url: SITE.url,
  telephone: SITE.phoneHref.replace("tel:", ""),
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    postalCode: SITE.address.zip,
    addressLocality: SITE.address.city,
    addressCountry: SITE.address.countryCode,
  },
};
const mapQuery = encodeURIComponent(`${SITE.address.street}, ${SITE.address.zip} ${SITE.address.city}`);
---

<Base
  title="Kontakt"
  description={`Kontaktirajte Juta Svet — ${SITE.address.street}, ${SITE.address.city}. Tel. ${SITE.phone}, ${SITE.email}. Upiti za kanap po meri, dekoraciju i veće količine.`}
  jsonLd={[localLd]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Kontakt" }]} />
    <div class="contact">
      <div class="prose">
        <h1>Kontakt</h1>
        <p class="lead">
          Pitanja o proizvodima, kanap po meri, dekoracija za lokal ili veće količine — javite
          se. Trudimo se da odgovorimo isti dan.
        </p>
        <ul class="contact__list">
          <li>
            <span>Adresa</span>
            <a href={`https://maps.google.com/?q=${mapQuery}`} target="_blank" rel="noopener">
              {SITE.address.street}, {SITE.address.zip} {SITE.address.city}
            </a>
          </li>
          <li>
            <span>Telefon</span>
            <a href={SITE.phoneHref}>{SITE.phone}</a>
          </li>
          <li>
            <span>Email</span>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li>
            <span>Instagram</span>
            <a href={SITE.social.instagram} target="_blank" rel="noopener">
              {SITE.social.instagramHandle}
            </a>
          </li>
          <li>
            <span>TikTok</span>
            <a href={SITE.social.tiktok} target="_blank" rel="noopener">
              {SITE.social.tiktokHandle}
            </a>
          </li>
        </ul>
        <p class="contact__note">
          Za dekoraciju po meri pošaljite dimenzije i fotografije prostora — predložićemo
          rešenje i cenu.
        </p>
      </div>

      <form class="inq" data-inquiry novalidate>
        <h2>Pošaljite upit</h2>
        <div class="field">
          <label for="q-product">Proizvod (opciono)</label>
          <input id="q-product" name="product" type="text" maxlength="200" placeholder="npr. Jutani luster" />
        </div>
        <div class="field">
          <label for="q-name">Ime i prezime</label>
          <input id="q-name" name="name" type="text" autocomplete="name" maxlength="120" />
        </div>
        <div class="inq__row">
          <div class="field">
            <label for="q-email">Email</label>
            <input id="q-email" name="email" type="email" autocomplete="email" maxlength="200" />
          </div>
          <div class="field">
            <label for="q-phone">Telefon</label>
            <input id="q-phone" name="phone" type="tel" autocomplete="tel" maxlength="60" />
          </div>
        </div>
        <p class="hint">Ostavite email ili telefon — kako vam je lakše da odgovorimo.</p>
        <div class="field">
          <label for="q-msg">Poruka</label>
          <textarea id="q-msg" name="message" rows="5" maxlength="4000" required placeholder="Debljina, dužina, količina, dimenzije prostora…"></textarea>
        </div>
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
        <button class="btn btn--lg btn--block" type="submit">Pošalji upit</button>
        <p class="inq__status" data-status role="status" hidden></p>
      </form>
    </div>
  </div>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 460px);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: 0.5rem 2.5rem;
  }
  @media (max-width: 800px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
  .prose h1 {
    font-size: var(--step-3);
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin: 0.5rem 0 1.5rem;
    max-width: 48ch;
  }
  .contact__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .contact__list li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .contact__list span:first-child {
    font: 500 0.74rem/1.6 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .contact__list a {
    color: var(--accent);
    text-decoration: none;
  }
  .contact__note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .inq {
    display: grid;
    gap: 0.9rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .inq h2 {
    font-size: var(--step-2);
  }
  .inq__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  @media (max-width: 440px) {
    .inq__row {
      grid-template-columns: 1fr;
    }
  }
  .inq .hint {
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-top: -0.4rem;
  }
  .inq textarea {
    resize: vertical;
  }
  .inq__status {
    font-size: 0.9rem;
  }
  .inq__status.ok {
    color: var(--success);
    font-weight: 600;
  }
  .inq__status.err {
    color: var(--danger);
  }
</style>

<script>
  import { withBase } from "../lib/url";

  const form = document.querySelector<HTMLFormElement>("[data-inquiry]");
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const params = new URLSearchParams(location.search);
    const prod = params.get("proizvod");
    if (prod) {
      (form.elements.namedItem("product") as HTMLInputElement).value = prod.slice(0, 200);
      const msg = form.elements.namedItem("message") as HTMLTextAreaElement;
      if (!msg.value) msg.value = `Zanima me cena i rok izrade za: ${prod}.\n`;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries()) as Record<string, string>;
      const show = (txt: string, ok: boolean) => {
        status.textContent = txt;
        status.className = `inq__status ${ok ? "ok" : "err"}`;
        status.hidden = false;
      };
      if (!data.email?.trim() && !data.phone?.trim()) return show("Ostavite email ili telefon.", false);
      if (!data.message?.trim()) return show("Napišite poruku.", false);

      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      btn.disabled = true;
      btn.textContent = "Šaljem…";
      try {
        const res = await fetch(withBase("/api/upit"), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) throw new Error(out.error || "Slanje nije uspelo.");
        form.reset();
        show("Hvala! Upit je poslat — javljamo se uskoro.", true);
        btn.textContent = "Poslato";
      } catch (err) {
        show((err as Error).message, false);
        btn.disabled = false;
        btn.textContent = "Pošalji upit";
      }
    });
  }
</script>

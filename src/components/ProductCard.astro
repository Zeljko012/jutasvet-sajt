---
import { priceFromLabel, type Product } from "../data/products";
import { money, discountPct } from "../lib/format";
import { withBase } from "../lib/url";

interface Props {
  product: Product;
  /** prioritetno učitavanje slike (za prve u gridu) */
  eager?: boolean;
}

const { product: p, eager = false } = Astro.props;
const href = withBase(`/proizvod/${p.slug}`);
const img = p.images[0];
const imgSrc = withBase(img?.src ?? "");
const off = discountPct(p.price, p.compareAt);
// direktno u korpu samo kad nema šta da se bira i cena je poznata
const single = p.variants.length === 1 && !p.onRequest ? p.variants[0] : null;
const ctaLabel = p.onRequest ? "Pošalji upit" : single ? "Dodaj u korpu" : "Izaberi opcije";
const firstOpt = p.options[0];
const numLead = (v: string) => /^(fi\s*)?\d/i.test(v.trim());
const optSummary = !firstOpt || firstOpt.values.length < 2
  ? ""
  : firstOpt.values.every(numLead)
    ? `${firstOpt.name} ${firstOpt.values[0]} – ${firstOpt.values[firstOpt.values.length - 1]}`
    : `${firstOpt.values.length} ${firstOpt.values.length < 5 ? "opcije" : "opcija"}`;
---

<article class="pc">
  <a class="pc__media" href={href}>
    {off && <span class="pill pill--sale pc__badge">−{off}%</span>}
    <img
      src={imgSrc}
      alt={img?.alt ?? p.name}
      width="600"
      height="750"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
    {
      single ? (
        <button
          type="button"
          class="pc__add"
          data-quick-add
          data-slug={p.slug}
          data-name={p.name}
          data-price={single.price}
          data-color={single.key}
          data-color-label={single.label}
          data-image={imgSrc}
          aria-label={`Dodaj „${p.name}” u korpu`}
        >
          {ctaLabel}
        </button>
      ) : (
        <span class="pc__add" aria-hidden="true">{ctaLabel}</span>
      )
    }
  </a>

  <div class="pc__body">
    <p class="pc__group">{p.group}</p>
    <h3 class="pc__name"><a href={href}>{p.name}</a></h3>
    {optSummary && <p class="pc__spec">{optSummary}</p>}
    <p class="pc__price">
      {
        p.compareAt && !p.onRequest && (
          <span class="price__old">{money(p.compareAt)}</span>
        )
      }
      <span class:list={["price", { "price__now--sale": !!p.compareAt, "pc__ask": p.onRequest }]}>
        {priceFromLabel(p, money)}
      </span>
    </p>
  </div>
</article>

<style>
  .pc {
    display: flex;
    flex-direction: column;
  }
  .pc__media {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-tint);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 5;
  }
  .pc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pc__media:hover img {
    transform: scale(1.04);
  }
  .pc__badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 2;
  }
  .pc__add {
    text-align: center;
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.7rem 1rem;
    border: none;
    border-radius: 999px;
    background: var(--ground);
    color: var(--ink);
    font: 600 0.85rem/1 var(--font-body);
    cursor: pointer;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      background-color 0.18s ease;
  }
  .pc__media:hover .pc__add,
  .pc__media:focus-within .pc__add {
    opacity: 1;
    transform: translateY(0);
  }
  .pc__add:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  /* telefon/tablet: nema hover-a — kartica vodi na proizvod, bez dugmeta preko slike */
  @media (hover: none) {
    .pc__add {
      display: none;
    }
  }

  .pc__body {
    padding-top: 0.7rem;
  }
  .pc__group {
    font: 500 0.68rem/1.2 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--clay);
    margin-bottom: 0.3rem;
  }
  .pc__ask {
    color: var(--accent);
  }
  .pc__name {
    font-size: 1.05rem;
  }
  .pc__name a {
    text-decoration: none;
  }
  .pc__name a:hover {
    color: var(--accent);
  }
  .pc__spec {
    font: 500 0.72rem/1.3 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }
  .pc__price {
    margin-top: 0.4rem;
  }
</style>

<script>
  import { addItem } from "../lib/cart";

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-quick-add]");
    if (!btn) return;
    e.preventDefault();
    addItem({
      slug: btn.dataset.slug!,
      name: btn.dataset.name!,
      price: Number(btn.dataset.price),
      color: btn.dataset.color!,
      colorLabel: btn.dataset.colorLabel!,
      image: btn.dataset.image!,
    });
    window.dispatchEvent(new CustomEvent("juta:added"));
    window.dispatchEvent(
      new CustomEvent("juta:toast", { detail: `„${btn.dataset.name}” dodato u korpu` }),
    );
  });
</script>

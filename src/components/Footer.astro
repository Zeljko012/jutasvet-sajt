---
import { SITE } from "../data/site";
import { CATEGORIES, CATEGORY_META } from "../data/products";
import { withBase } from "../lib/url";
const year = new Date().getFullYear();
const L = withBase;
---

<footer class="site-footer">
  <div class="container foot-grid">
    <div class="foot-brand">
      <div class="mark">
        <img src={L("/logo-mark.png")} alt="" width="40" height="40" loading="lazy" />
        {SITE.name}
      </div>
      <p>{SITE.tagline}. Porodična proizvodnja iz Požarevca.</p>
      <div class="socials">
        <a href={SITE.social.instagram} rel="me noopener" target="_blank" class="ig">
          Instagram {SITE.social.instagramHandle}
        </a>
        <a href={SITE.social.tiktok} rel="me noopener" target="_blank" class="ig">
          TikTok {SITE.social.tiktokHandle}
        </a>
      </div>
    </div>

    <nav aria-label="Prodavnica">
      <h4>Prodavnica</h4>
      <ul>
        {CATEGORIES.map((c) => <li><a href={L(`/kategorija/${c}`)}>{CATEGORY_META[c].title}</a></li>)}
        <li><a href={L("/prodavnica")}>Svi proizvodi</a></li>
        <li><a href={L("/primena")}>Primena jute</a></li>
        <li><a href={L("/vodic")}>Vodič</a></li>
        <li><a href={L("/reference")}>Reference</a></li>
      </ul>
    </nav>

    <nav aria-label="Pomoć">
      <h4>Pomoć</h4>
      <ul>
        <li><a href={L("/dostava-i-povracaj")}>Dostava i povraćaj</a></li>
        <li><a href={L("/cesta-pitanja")}>Česta pitanja</a></li>
        <li><a href={L("/kontakt")}>Kontakt</a></li>
        <li><a href={L("/uslovi-koriscenja")}>Uslovi korišćenja</a></li>
        <li><a href={L("/politika-privatnosti")}>Politika privatnosti</a></li>
      </ul>
    </nav>

    <nav aria-label="Kontakt">
      <h4>Kontakt</h4>
      <ul>
        <li>{SITE.address.street}<br />{SITE.address.zip} {SITE.address.city}</li>
        <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container foot-legal">
    <span>© {year} {SITE.name}. Sva prava zadržana.</span>
    <span>Plaćanje pouzećem · Dostava po celoj Srbiji</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: clamp(2.5rem, 6vw, 3.75rem);
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .foot-brand .mark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
  }
  .foot-brand .mark img {
    width: 40px;
    height: 40px;
  }
  .socials {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.5rem;
  }
  .foot-brand p {
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 32ch;
    margin-top: 0.5rem;
  }
  .foot-brand .ig {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--accent);
  }
  h4 {
    font: 500 0.76rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  li,
  li a {
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }
  li a:hover {
    color: var(--accent);
  }
  .foot-legal {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  @media (max-width: 760px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 440px) {
    .foot-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
